{
  "name": "pan-buttle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run typecheck && node scripts/clean-build.mjs && vite build",
    "check:size": "node scripts/check-size.mjs",
    "test:e2e": "node scripts/playwright.mjs test",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser:install": "node scripts/playwright.mjs install chromium --only-shell"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
